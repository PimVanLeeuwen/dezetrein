# Copy to .env next to docker-compose.yml on the server (never commit it).
# NS API portal key (apiportal.ns.nl, product Ns-App).
NS_API_KEY=
# Address and port the web container is published on: the address the tunnel or reverse proxy
# connects from (for example the Docker bridge gateway for a cloudflared container on the
# bridge network). Default 127.0.0.1:8080.
WEB_BIND=127.0.0.1
WEB_PORT=8080
# Optional: pin a release instead of following :latest.
# BACKEND_IMAGE=ghcr.io/pimvanleeuwen/dezetrein-backend:v1.0.0
# WEB_IMAGE=ghcr.io/pimvanleeuwen/dezetrein-web:v1.0.0
